{
  "name": "lumapost",
  "version": "10.7.2",
  "description": "LumaPost 光影邮报 — AI 驱动的智能新闻邮件系统。163 个信息源 · 13 个中文热榜 · 10 个阅读分区 · 纯 CLI 驱动，无 Web UI。",
  "main": "scripts/cli.js",
  "scripts": {
    "all:afternoon": "npm run fetch:afternoon && npm run gen:afternoon && npm run send:afternoon",
    "all:evening": "npm run fetch:evening && npm run gen:evening && npm run send:evening",
    "all:morning": "npm run fetch:morning && npm run gen:morning && npm run send:morning",
    "all:noon": "npm run fetch:noon && npm run gen:noon && npm run send:noon",
    "config:reset": "node -e \"require('./scripts/config-store').reset();console.log('配置已重置')\"",
    "doctor": "node scripts/cli.js doctor",
    "fetch:afternoon": "node scripts/fetch-news-ai.js --period=afternoon --output=data/afternoon-latest.json",
    "fetch:evening": "node scripts/fetch-news-ai.js --period=evening --output=data/evening-latest.json",
    "fetch:morning": "node scripts/fetch-news-ai.js --period=morning --output=data/morning-latest.json",
    "fetch:noon": "node scripts/fetch-news-ai.js --period=noon --output=data/noon-latest.json",
    "gen:afternoon": "node scripts/gen-html.js --data-file=data/afternoon-latest.json --output=data/afternoon-email.html",
    "gen:evening": "node scripts/gen-html.js --data-file=data/evening-latest.json --output=data/evening-email.html",
    "gen:morning": "node scripts/gen-html.js --data-file=data/morning-latest.json --output=data/morning-email.html",
    "gen:noon": "node scripts/gen-html.js --data-file=data/noon-latest.json --output=data/noon-email.html",
    "mail:list": "node scripts/mail-provider.js --list",
    "mail:test": "node scripts/mail-provider.js --test",
    "scheduler": "node -e \"require('./scripts/scheduler').start()\"",
    "send:afternoon": "node scripts/send-mail.js --period=afternoon",
    "send:evening": "node scripts/send-mail.js --period=evening",
    "send:morning": "node scripts/send-mail.js --period=morning",
    "send:noon": "node scripts/send-mail.js --period=noon",
    "search": "node scripts/web-search.js",
    "hot": "node scripts/hotboard.js",
    "hot:stock": "node scripts/hotboard.js stock",
    "test": "node tests/run.js",
    "selfcheck": "node scripts/json-repair.js",
    "migrate": "node scripts/migrate.js",
    "start": "node scripts/cli.js serve",
    "cli": "node scripts/cli.js",
    "status": "node scripts/cli.js status",
    "sources": "node scripts/cli.js sources",
    "sections": "node scripts/cli.js sections",
    "sections:enable": "node scripts/cli.js sections:enable",
    "sources:enable": "node scripts/cli.js sources:enable",
    "preview": "node scripts/cli.js preview morning",
    "test:ai": "node scripts/cli.js test-ai",
    "test:mail": "node scripts/cli.js test-mail"
  },
  "keywords": [
    "news",
    "email",
    "newsletter",
    "ai",
    "llm",
    "automation",
    "cli",
    "rss",
    "digest"
  ],
  "author": "QiXua & Operit AI",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "nodemailer": "^7.0.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mao2973464622/lumapost.git"
  },
  "bin": {
    "lumapost": "scripts/cli.js"
  }
}
